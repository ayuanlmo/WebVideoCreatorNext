{
  "name": "web-video-creator-next",
  "version": "0.1.1",
  "description": "A framework for creating videos based on Node.js + Puppeteer + FFmpeg. TypeScript rewrite of Vinlic/WebVideoCreator.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-import-extensions.mjs && node scripts/build-browser.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run test/unit --coverage",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "postinstall": "node scripts/install-ffmpeg.mjs",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "author": "ayuanlmo",
  "contributors": [
    "Vinlic (original author of WebVideoCreator)"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayuanlmo/WebVideoCreatorNext.git"
  },
  "bugs": "https://github.com/ayuanlmo/WebVideoCreatorNext/issues",
  "files": [
    "dist",
    "docs",
    "scripts/install-ffmpeg.mjs",
    "README.md",
    "README.en-US.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "puppeteer",
    "screen",
    "screen recorder",
    "video capture",
    "video recorder",
    "video",
    "ffmpeg",
    "record",
    "cast",
    "shot",
    "chrome",
    "chromium",
    "render",
    "synthesis",
    "animation",
    "canvas",
    "web",
    "html5",
    "vtuber",
    "automatic",
    "automation",
    "screen frame",
    "screeencast",
    "screeencasts",
    "headless",
    "typescript"
  ],
  "dependencies": {
    "@puppeteer/browsers": "^3.2.7",
    "async-lock": "^1.4.1",
    "cli-progress": "^3.12.0",
    "eventemitter3": "^5.0.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "generic-pool": "^3.9.0",
    "lodash": "^4.17.21",
    "picocolors": "^1.1.1",
    "puppeteer-core": "^25.17.0",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/cli-progress": "^3.11.6",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static"
    ]
  }
}